# ArcMux Docker production environment
# Copy to .env.prod (gitignored via .env*) or let scripts/deploy-docker.sh generate it.
#
# Password notes:
# - Prefer hex/base64 without @ : / # ? & so SQL/Redis URLs stay simple.
# - The deploy script generates safe random secrets automatically.

# -------- Host publish --------
HOST_BIND=0.0.0.0
HOST_PORT=3000
TZ=Asia/Shanghai
ARCMUX_IMAGE=arcmux:latest
DATA_DIR=./data
LOG_DIR=./logs
NODE_NAME=arcmux-1

# -------- PostgreSQL --------
POSTGRES_USER=arcmux
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=arcmux

# -------- Redis --------
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# -------- App secrets (required) --------
SESSION_SECRET=CHANGE_ME_SESSION_SECRET
CRYPTO_SECRET=CHANGE_ME_CRYPTO_SECRET

# Optional: encrypt upstream OAuth credentials at rest
# UPSTREAM_CREDENTIAL_ENCRYPTION_KEY=

# -------- Runtime flags --------
ERROR_LOG_ENABLED=true
BATCH_UPDATE_ENABLED=true

# -------- HTTPS / reverse proxy (set after you put TLS in front) --------
# SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_TRUSTED_URL=https://www.example.com,https://api.example.com
# TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
#
# IMPORTANT: SESSION_COOKIE_TRUSTED_URL must list EVERY exact HTTPS Origin
# that hosts the dashboard (the browser tab URL), not just the relay API
# domain. The frontend silently refreshes its 15-minute access token via
# POST /api/user/auth/refresh; if that request's Origin is not allow-listed
# here (or does not exactly match the Host the browser is talking to), the
# server rejects it with 403 AUTH_ORIGIN_FORBIDDEN and the dashboard signs
# the user out ~15 minutes after login. Multiple values are comma-separated;
# wildcards, paths and suffix matching are not supported.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_TRUSTED_URL=
TRUSTED_PROXIES=
